{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Terra example catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "examples"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "title",
          "description",
          "path",
          "next_steps"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^examples/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "next_steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "directory",
                "instruction"
              ],
              "properties": {
                "directory": {
                  "type": "string",
                  "minLength": 1
                },
                "instruction": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
