# Terra API credentials - dashboard.tryterra.co, API credentials page.
# Leave both empty to run in DEMO MODE (bundled synthetic records, read-only).
# The dev ID needs the CLINICAL_RECORD data type enabled in the dashboard.
TERRA_DEV_ID=
TERRA_API_KEY=

# Webhook signing secret - dashboard.tryterra.co, Destinations > Webhook.
# Optional: enables POST /api/webhook (unified_api.clinical_record.updated).
TERRA_WEBHOOK_SECRET=

# Optional overrides
# TERRA_BASE_URL=https://api.tryterra.co/v2
# PORT=8787
# DATABASE_URL=file:./data/app.db
