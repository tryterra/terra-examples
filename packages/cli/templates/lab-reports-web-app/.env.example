# Terra API credentials — dashboard.tryterra.co, API credentials page.
# Leave both empty to run in DEMO MODE (bundled sample data, read-only).
TERRA_DEV_ID=
TERRA_API_KEY=

# Anthropic API key — console.anthropic.com. Optional: enables live AI
# (brief regeneration, chat, on-demand wearable-signal insights). Without
# it, pre-generated AI content still renders in demo mode.
ANTHROPIC_API_KEY=

# Optional overrides
# TERRA_BASE_URL=https://access.tryterra.co/api/v2
# PORT=8787
# DATABASE_URL=file:./data/app.db
