{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true
    },
    "wear": {
      "config": "wear.yml",
      "android": {
        "buildArtifactPaths": ["../wearos/app/build/outputs/bundle/release/*.aab"]
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "YOUR_ASC_APP_ID"
      },
      "android": {
        "track": "internal"
      }
    },
    "wear": {
      "android": {
        "track": "internal"
      }
    }
  }
}
